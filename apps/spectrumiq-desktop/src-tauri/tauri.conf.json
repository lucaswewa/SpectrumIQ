{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpectrumIQ",
  "version": "0.1.0",
  "identifier": "io.github.lucaswewa.spectrumiq",
  "build": {
    "frontendDist": "../connect"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SpectrumIQ",
        "url": "index.html",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
