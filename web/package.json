{
  "name": "spectrumiq-web",
  "version": "0.1.0",
  "private": true,
  "description": "SpectrumIQ's web app.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "api:openapi": "cargo run -q -p spectrumiq-server --locked -- --print-openapi > src/api/generated/openapi.json",
    "api:types": "openapi-typescript src/api/generated/openapi.json -o src/api/generated/schema.d.ts --default-non-nullable false"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.47.5",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
